    "definitions": {
        "domain.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "integer"
                },
                "user_name": {
                    "type": "string"
                },
                "user_type": {
                    "$ref": "#/definitions/domain.UserType"
                }
            }
        },
        "domain.UserType": {
            "type": "string",
            "enum": [
                "BUYER",
                "SELLER",
                "BOTH"
            ],
            "x-enum-varnames": [
                "UserTypeBuyer",
                "UserTypeSeller",
                "UserTypeBoth"
            ]
        },
        "request.CreatePostRequest": {
            "type": "object",
            "required": [
                "category",
                "date",
                "price",
                "product",
                "user_id"
            ],
            "properties": {
                "category": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "product": {
                    "$ref": "#/definitions/request.ProductRequest"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "request.CreatePromoPostRequest": {
            "type": "object",
            "required": [
                "category",
                "date",
                "price",
                "product",
                "user_id"
            ],
            "properties": {
                "category": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "discount": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0
                },
                "has_promo": {
                    "type": "boolean"
                },
                "price": {
                    "type": "number"
                },
                "product": {
                    "$ref": "#/definitions/request.ProductRequest"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "request.CreateUserRequest": {
            "type": "object",
            "required": [
                "password",
                "user_name",
                "user_type"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 6
                },
                "user_name": {
                    "type": "string",
                    "maxLength": 15,
                    "minLength": 3
                },
                "user_type": {
                    "$ref": "#/definitions/domain.UserType"
                }
            }
        },
        "request.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "user_name"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "user_name": {
                    "type": "string"
                }
            }
        },
        "request.ProductRequest": {
            "type": "object",
            "required": [
                "product_name",
                "type"
            ],
            "properties": {
                "brand": {
                    "type": "string",
                    "maxLength": 50
                },
                "color": {
                    "type": "string",
                    "maxLength": 20
                },
                "notes": {
                    "type": "string"
                },
                "product_name": {
                    "type": "string",
                    "maxLength": 40
                },
                "type": {
                    "type": "string",
                    "maxLength": 15
                }
            }
        },
        "request.UpdateUserRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "maxLength": 72,
                    "minLength": 6
                },
                "user_name": {
